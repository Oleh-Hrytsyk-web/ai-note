{
  "expo": {
    "name": "AI Note",
    "scheme": "ai-note",
    "slug": "ai-note",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.olehhrytsyk.ainote",
      "supportsTablet": true
    },
    "android": {
      "package": "com.olehhrytsyk.ainote",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-speech-recognition", {
        "microphonePermission": "Allow AI Note to capture your spoken thoughts.",
        "speechRecognitionPermission": "Allow AI Note to turn your speech into text."
      }],
      "expo-localization"
    ]
  }
}
