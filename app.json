{
  "expo": {
    "name": "AI Note",
    "scheme": "ai-note",
    "slug": "ai-note",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.olehhrytsyk.ainote",
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow AI Note to turn your speech into text.",
        "NSMicrophoneUsageDescription": "Allow AI Note to capture your spoken thoughts."
      }
    },
    "android": {
      "package": "com.olehhrytsyk.ainote",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow AI Note to capture your spoken thoughts.",
          "speechRecognitionPermission": "Allow AI Note to turn your speech into text."
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de1b7b45-2f64-45fb-9c91-62395fd0848d"
      }
    },
    "owner": "oleggrytsyk34"
  }
}
